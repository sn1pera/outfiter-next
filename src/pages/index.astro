---
const title = 'Outfiter — your closet, considered';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f0" />
    <meta name="description" content="A calmer way to plan outfits, organize your wardrobe, and make more of what you own." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root{font-family:'DM Sans',sans-serif;color:#23251f;background:#f6f5f0;font-synthesis:none;text-rendering:optimizeLegibility;--ink:#23251f;--muted:#77796f;--line:#e4e3db;--green:#304b3d;--lime:#d9ec9b;--paper:#fffefa}*{box-sizing:border-box}body{margin:0;min-width:320px}button,input,select{font:inherit}button{cursor:pointer}.shell{max-width:1440px;margin:auto;padding:0 56px}.topbar{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;letter-spacing:-1px}.brand i{font-style:normal;color:#819967}.nav{display:flex;gap:34px;color:#686b60;font-size:13px}.nav a{color:inherit;text-decoration:none}.nav a.active{color:var(--ink);font-weight:700}.profile{display:flex;gap:10px;align-items:center;font-size:13px}.avatar{height:34px;width:34px;border-radius:50%;display:grid;place-items:center;background:#e8e9dc;color:var(--green);font-weight:700}.hero{padding:42px 0 30px;display:flex;justify-content:space-between;align-items:end}.eyebrow{text-transform:uppercase;letter-spacing:1.8px;font-size:10px;font-weight:700;color:#78806b}.hero h1{font-family:'Playfair Display',serif;font-size:43px;line-height:1.12;letter-spacing:-1.5px;margin:9px 0 8px;font-weight:600}.hero p{margin:0;color:var(--muted);font-size:14px}.date-chip{background:#eaece1;border-radius:30px;padding:10px 15px;font-size:12px;color:#4f5c46}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(340px,.8fr);gap:22px;padding-bottom:50px}.panel{background:var(--paper);border:1px solid var(--line);border-radius:16px}.wardrobe{padding:24px}.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:21px}.panel-head h2{font-family:'Playfair Display',serif;font-size:23px;margin:0;font-weight:600}.count{font-size:11px;color:var(--muted);margin-left:8px}.btn{border:0;border-radius:8px;padding:11px 15px;font-size:12px;font-weight:700;transition:transform .15s,background .15s}.btn:hover{transform:translateY(-1px)}.btn-dark{background:var(--green);color:white}.btn-light{background:#f0f1e9;color:#344936}.btn-lime{background:var(--lime);color:#293728}.filters{display:flex;align-items:center;justify-content:space-between;margin-bottom:17px;gap:12px}.tabs{display:flex;gap:5px;flex-wrap:wrap}.tab{border:0;border-radius:20px;padding:8px 12px;color:#71746a;background:transparent;font-size:11px}.tab.active{background:#e9ecdf;color:#334a39;font-weight:700}.search{width:180px;border:1px solid var(--line);background:#fffefa;padding:9px 11px;border-radius:8px;font-size:11px;outline:none}.search:focus,input:focus,select:focus{border-color:#819967}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.item{border:1px solid var(--line);border-radius:11px;overflow:hidden;background:#fff;position:relative}.item-art{height:130px;display:grid;place-items:center;font-size:51px;position:relative}.item-art:after{content:'';position:absolute;inset:auto 0 0;height:35%;background:linear-gradient(transparent,rgba(0,0,0,.035))}.item-body{padding:11px 12px 12px}.item-name{font-weight:700;font-size:12px}.item-meta{font-size:10px;color:var(--muted);margin-top:5px;display:flex;justify-content:space-between}.dots{position:absolute;right:9px;top:8px;border:0;width:25px;height:25px;border-radius:50%;background:#ffffffd9;color:#5a5c55;font-size:16px;z-index:1}.rightcol{display:flex;flex-direction:column;gap:18px}.builder{padding:24px;background:#e8eddf}.builder .panel-head{margin-bottom:5px}.builder .panel-head h2{font-size:22px}.builder-note{color:#697362;font-size:12px;margin:0 0 18px}.occasion{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:15px}.occasion button{border:1px solid #d5dacb;background:#f5f6ef;color:#687063;border-radius:20px;padding:7px 10px;font-size:10px}.occasion button.active{background:var(--green);color:#fff;border-color:var(--green)}.look{min-height:210px;background:#f8f8f3;border:1px dashed #cbd2bf;border-radius:12px;padding:16px;display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap}.look.empty{flex-direction:column;text-align:center;color:#8b9082;font-size:12px;gap:9px}.look.empty b{font-size:28px;font-weight:400}.look-card{width:31%;min-width:82px;text-align:center}.look-emoji{height:98px;border-radius:9px;display:grid;place-items:center;font-size:38px;background:#e5e9dd}.look-label{font-size:9px;color:#62665d;margin-top:7px}.builder-actions{display:flex;gap:8px;margin-top:14px}.builder-actions .btn{flex:1}.saved{padding:20px 22px}.saved .panel-head{margin-bottom:13px}.saved h2{font-family:'Playfair Display',serif;font-size:19px;margin:0}.saved-list{display:flex;flex-direction:column;gap:9px}.saved-empty{font-size:12px;color:var(--muted);padding:10px 0}.saved-row{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:10px;font-size:11px}.saved-row span:last-child{color:var(--muted);font-size:10px}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);background:#243d31;color:white;padding:12px 17px;border-radius:9px;font-size:12px;opacity:0;pointer-events:none;transition:.25s;z-index:9}.toast.show{opacity:1;transform:translate(-50%,0)}dialog{border:1px solid var(--line);border-radius:15px;padding:25px;width:min(420px,calc(100% - 32px));box-shadow:0 22px 80px #20231c30;color:var(--ink)}dialog::backdrop{background:#24271f66}dialog h2{font-family:'Playfair Display',serif;margin:0 0 18px}form{display:grid;gap:12px}label{font-size:11px;color:#65695f;display:grid;gap:6px}input,select{padding:11px;border:1px solid var(--line);border-radius:8px;background:white;outline:none;color:var(--ink)}.form-actions{display:flex;gap:9px;justify-content:flex-end;margin-top:8px}.footer{border-top:1px solid var(--line);padding:22px 0;color:#888a80;font-size:10px;display:flex;justify-content:space-between}.empty-wardrobe{grid-column:1/-1;text-align:center;padding:35px;color:var(--muted);font-size:13px}
      @media(max-width:900px){.shell{padding:0 26px}.layout{grid-template-columns:1fr}.rightcol{display:grid;grid-template-columns:1fr 1fr}.nav{gap:15px}}
      @media(max-width:600px){.shell{padding:0 17px}.topbar{height:66px}.nav{display:none}.hero{padding:31px 0 23px;align-items:start;gap:12px;flex-direction:column}.hero h1{font-size:35px}.date-chip{font-size:10px}.layout{gap:14px}.wardrobe{padding:17px}.panel-head h2{font-size:21px}.filters{align-items:flex-start;flex-direction:column}.search{width:100%}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.item-art{height:112px}.rightcol{display:flex}.builder{padding:18px}.saved{padding:18px}.footer{gap:10px;flex-direction:column}}
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="brand">outfit<i>er</i></div>
        <nav class="nav"><a class="active" href="#wardrobe">My wardrobe</a><a href="#planner">Outfit planner</a><a href="#saved">Saved looks</a></nav>
        <div class="profile"><span class="avatar">S</span><span>My closet</span></div>
      </header>
      <main>
        <section class="hero"><div><div class="eyebrow">Wednesday, November 25</div><h1>Get dressed, <em>your way.</em></h1><p>A little inspiration from the pieces you already love.</p></div><div class="date-chip">✦ &nbsp; Your style, simplified</div></section>
        <div class="layout">
          <section class="panel wardrobe" id="wardrobe">
            <div class="panel-head"><h2>Your wardrobe <span class="count" id="item-count"></span></h2><button class="btn btn-dark" id="add-open">＋ Add a piece</button></div>
            <div class="filters"><div class="tabs" id="tabs"><button class="tab active" data-filter="All">All pieces</button><button class="tab" data-filter="Tops">Tops</button><button class="tab" data-filter="Bottoms">Bottoms</button><button class="tab" data-filter="Shoes">Shoes</button><button class="tab" data-filter="Outerwear">Outerwear</button></div><input class="search" id="search" placeholder="⌕  Search your closet" aria-label="Search wardrobe" /></div>
            <div class="grid" id="wardrobe-grid"></div>
          </section>
          <aside class="rightcol">
            <section class="panel builder" id="planner">
              <div class="panel-head"><h2>Today's outfit</h2><span>✦</span></div><p class="builder-note">A fresh combination, picked just for you.</p>
              <div class="occasion" id="occasions"><button class="active" data-occasion="Everyday">Everyday</button><button data-occasion="Work">Work</button><button data-occasion="Weekend">Weekend</button><button data-occasion="Going out">Going out</button></div>
              <div class="look empty" id="look"><b>✳</b><span>Pick an outfit from your wardrobe</span></div>
              <div class="builder-actions"><button class="btn btn-light" id="shuffle">↻ &nbsp; New outfit</button><button class="btn btn-lime" id="save-look">♡ &nbsp; Save look</button></div>
            </section>
            <section class="panel saved" id="saved"><div class="panel-head"><h2>Saved looks</h2><span class="count" id="saved-count"></span></div><div class="saved-list" id="saved-list"></div></section>
          </aside>
        </div>
      </main>
      <footer class="footer"><span>Outfiter — wear what you have, love what you wear.</span><span>Your wardrobe stays on this device.</span></footer>
    </div>
    <dialog id="add-dialog"><h2>Add to your wardrobe</h2><form id="add-form"><label>What is it called?<input name="name" placeholder="e.g. Linen button-up" maxlength="40" required /></label><label>Category<select name="category"><option>Tops</option><option>Bottoms</option><option>Shoes</option><option>Outerwear</option><option>Accessories</option></select></label><label>Color<input name="color" placeholder="e.g. cream" maxlength="24" required /></label><div class="form-actions"><button class="btn btn-light" type="button" id="cancel-add">Cancel</button><button class="btn btn-dark" type="submit">Add piece</button></div></form></dialog>
    <div class="toast" id="toast" role="status"></div>
    <script>
      const starter=[
        {id:'a1',name:'Everyday tee',category:'Tops',color:'Soft white',emoji:'👕',bg:'#e9ebe5'},
        {id:'a2',name:'Knit crewneck',category:'Tops',color:'Sage green',emoji:'🧶',bg:'#e4e9dc'},
        {id:'a3',name:'Relaxed denim',category:'Bottoms',color:'Washed blue',emoji:'👖',bg:'#e3eaf0'},
        {id:'a4',name:'Wide-leg trousers',category:'Bottoms',color:'Warm taupe',emoji:'👖',bg:'#ece8df'},
        {id:'a5',name:'Leather sneakers',category:'Shoes',color:'Off white',emoji:'👟',bg:'#eeeae3'},
        {id:'a6',name:'Classic trench',category:'Outerwear',color:'Sand',emoji:'🧥',bg:'#eee8dc'}
      ];
      const art={Tops:'👕',Bottoms:'👖',Shoes:'👟',Outerwear:'🧥',Accessories:'🧢'};
      let items=read('outfiter-wardrobe',starter), saved=read('outfiter-saved',[]), filter='All', current=[], occasion='Everyday';
      const $=s=>document.querySelector(s), esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      function read(key,fallback){try{const x=JSON.parse(localStorage.getItem(key));return Array.isArray(x)?x:fallback}catch{return fallback}}
      function persist(){localStorage.setItem('outfiter-wardrobe',JSON.stringify(items));localStorage.setItem('outfiter-saved',JSON.stringify(saved))}
      function render(){const q=$('#search').value.toLowerCase();const shown=items.filter(x=>(filter==='All'||x.category===filter)&&(`${x.name} ${x.color} ${x.category}`.toLowerCase().includes(q)));$('#item-count').textContent=`${items.length} pieces`;$('#wardrobe-grid').innerHTML=shown.length?shown.map(x=>`<article class="item"><button class="dots" data-delete="${esc(x.id)}" aria-label="Remove ${esc(x.name)}">×</button><div class="item-art" style="background:${esc(x.bg||'#e9ebe5')}">${esc(x.emoji||art[x.category]||'✦')}</div><div class="item-body"><div class="item-name">${esc(x.name)}</div><div class="item-meta"><span>${esc(x.color)}</span><span>${esc(x.category)}</span></div></div></article>`).join(''):'<div class="empty-wardrobe">No pieces here yet. Add something you love.</div>';$('#saved-count').textContent=saved.length?`${saved.length}`:'';$('#saved-list').innerHTML=saved.length?saved.map(x=>`<div class="saved-row"><span>♡ &nbsp; ${esc(x.name)}</span><span>${esc(x.occasion)} · ${x.pieces.length} pieces</span></div>`).join(''):'<div class="saved-empty">Your favorite combinations will show up here.</div>';}
      function toast(message){const el=$('#toast');el.textContent=message;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2100)}
      function pick(){const groups=['Tops','Bottoms','Shoes'];const picked=groups.map(cat=>{const list=items.filter(x=>x.category===cat);return list.length?list[Math.floor(Math.random()*list.length)]:null}).filter(Boolean);if(occasion!=='Everyday'){const coats=items.filter(x=>x.category==='Outerwear');if(coats.length&&Math.random()>.35)picked.push(coats[Math.floor(Math.random()*coats.length)])}current=picked;drawLook()}
      function drawLook(){const el=$('#look');if(!current.length){el.className='look empty';el.innerHTML='<b>✳</b><span>Add tops, bottoms and shoes to build an outfit</span>';return}el.className='look';el.innerHTML=current.map(x=>`<div class="look-card"><div class="look-emoji" style="background:${esc(x.bg||'#e5e9dd')}">${esc(x.emoji||art[x.category]||'✦')}</div><div class="look-label">${esc(x.name)}</div></div>`).join('')}
      $('#tabs').addEventListener('click',e=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));render()});$('#search').addEventListener('input',render);$('#wardrobe-grid').addEventListener('click',e=>{const b=e.target.closest('[data-delete]');if(!b)return;items=items.filter(x=>x.id!==b.dataset.delete);current=current.filter(x=>x.id!==b.dataset.delete);persist();render();drawLook();toast('Piece removed from your wardrobe')});
      $('#add-open').onclick=()=>$('#add-dialog').showModal();$('#cancel-add').onclick=()=>$('#add-dialog').close();$('#add-form').addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget), category=d.get('category');const palette=['#e9ebe5','#e3eaf0','#eee8dc','#e4e9dc','#efe4e2','#ece8df'];items.unshift({id:crypto.randomUUID?.()||String(Date.now()),name:d.get('name').trim(),category,color:d.get('color').trim(),emoji:art[category]||'✦',bg:palette[Math.floor(Math.random()*palette.length)]});persist();render();e.currentTarget.reset();$('#add-dialog').close();toast('Added to your wardrobe ✦')});
      $('#occasions').addEventListener('click',e=>{const b=e.target.closest('[data-occasion]');if(!b)return;occasion=b.dataset.occasion;document.querySelectorAll('#occasions button').forEach(x=>x.classList.toggle('active',x===b))});$('#shuffle').onclick=()=>{pick();if(!current.length)toast('Add a few pieces to get started');else toast('A new look, just for you ✦')};$('#save-look').onclick=()=>{if(!current.length){toast('Build an outfit first');return}saved.unshift({name:`${occasion} look`,occasion,pieces:current.map(x=>x.id)});persist();render();toast('Look saved for later ♡')};render();
    </script>
  </body>
</html>
